{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./*"]
    },
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "types": ["node", "react", "react-native"]  // <-- ADD THIS LINE
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/types"
  ]
}
